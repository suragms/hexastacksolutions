# Copy to `.env` (or `.env.local`) and set values. Vite exposes only vars prefixed with VITE_.

# Backend API (Mongo)
# DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/hexastacksolutions
# JWT_SECRET=change-me-in-production

# Bootstrap first SUPER_ADMIN (npx tsx server/scripts/seed-super-admin.ts)
# SEED_ADMIN_EMAIL=you@example.com
# SEED_ADMIN_PASSWORD=ChangeMeNow!2026
# SEED_ADMIN_NAME=Anandu Krishna

# Email (Resend) — confirmation + quoted stage + enquiry alerts + daily reports
# RESEND_API_KEY=
# RESEND_FROM=HexaStack <onboarding@resend.dev>
# OPS_DIGEST_SECRET=change-me   # guards the daily-report / ops-digest cron endpoints
# SUPPORT_EMAIL=supporthexastacksolutions@gmail.com
# ADMIN_EMAIL=hexastacksolutions@gmail.com
# NOTE: Enquiry alerts and daily reports are emailed to the addresses in
# Admin → Settings → leadEmail1 / leadEmail2 / leadEmail3
# (defaults: hexastacksolutions@gmail.com, officialsurag@gmail.com, anandukrishna2999@gmail.com).

# WhatsApp Cloud API (optional MVP)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE=enquiry_thanks
# WHATSAPP_TEMPLATE_LANG=en

# AI caption generation (optional; falls back to template copy)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1

# Sitemap build: fetch published DB posts
# SITEMAP_API_URL=https://www.hexastacksolutions.com

# HexaBill marketing site
# VITE_HEXABILL_MARKETING_URL=https://hexabillmarketingpage.com

# Google Business Profile review link
# VITE_GOOGLE_REVIEW_URL=https://g.page/r/YourReviewLink

# Local: npm run dev (Vite + API). API: npm run dev:api
# VITE_DEV_API_PROXY=http://localhost:3001
# VITE_API_BASE_URL=
